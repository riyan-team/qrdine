<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\QrDine.Application\QrDine.Application.csproj" />
    <ProjectReference Include="..\QrDine.Infrastructure\QrDine.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="9.0.4" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    The restaurant PC edition: one DineIn.exe with the web pages inside, no .NET install needed on the PC.
    Built by deploy/pc/build-pc.sh:
      dotnet publish src/QrDine.Api -c Release -r win-x64 -p:PcEdition=true -o <folder>
  -->
  <PropertyGroup Condition="'$(PcEdition)' == 'true'">
    <DefineConstants>$(DefineConstants);PC_EDITION</DefineConstants>
    <AssemblyName>DineIn</AssemblyName>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CompressionEnabled>false</CompressionEnabled>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Product>Dine In</Product>
    <Company>Dine In</Company>
    <Description>Dine In restaurant system, PC edition</Description>
  </PropertyGroup>
  <ItemGroup Condition="'$(PcEdition)' == 'true'">
    <!-- The built web pages (frontend/dist) go inside the exe as "web" (not wwwroot, which never bundles). -->
    <!-- ASP.NET keeps settings and web pages out of a single file unless told otherwise. -->
    <Content Include="..\..\frontend\dist\**\*" LinkBase="web" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" ExcludeFromSingleFile="false" />
    <Content Update="appsettings.json;appsettings.Production.json;web.config" ExcludeFromSingleFile="false" />
    <Content Remove="appsettings.Development.json;wwwroot\uploads\**" />
    <None Include="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
