# Multi-stage build for the QrDine API. Build context = repository root.
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY QrDine.sln ./
COPY src/ ./src/
RUN dotnet restore QrDine.sln
RUN dotnet publish src/QrDine.Api/QrDine.Api.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "QrDine.Api.dll"]
