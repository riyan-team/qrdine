# Copy to .env and fill in. setup.sh generates strong random values automatically
# if .env is missing, so you normally don't edit this by hand — except GEMINI_API_KEY.
DOMAIN=qrdine.mystay.live
DB_PASSWORD=change-me
JWT_SECRET=change-me-long-random
PLATFORM_ADMIN_USER=superadmin
PLATFORM_ADMIN_PASSWORD=change-me
# Optional: paste a free Google AI Studio key to enable "import menu from photo".
GEMINI_API_KEY=
